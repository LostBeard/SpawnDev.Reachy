<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>0.1.0-preview.4</Version>
		<PackageReleaseNotes>0.1.0-preview.4 - Dependency update, no Reachy code change: SpawnDev.RTC 2.2.3 -> 2.3.1, the SpawnDev.SpawnJS 3 line (with SpawnDev.MultiMedia 2.4, SpawnDev.SpawnJS.Cryptography 2.1 and SpawnDev.SIPSorcery 10.0.10, which handles SCTP FORWARD TSN so a desktop data channel survives a peer that abandons unreliable chunks). Before this, an app on SpawnJS 3 that referenced Reachy resolved RTC 2.2.3 and its SpawnJS 2 dependency set. Full history: CHANGELOG.md</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.Reachy</Title>
		<Authors>LostBeard</Authors>
		<Description>A C# SDK for the Reachy Mini robot.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.Reachy</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.Reachy.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Reachy;ReachyMini;Robotics;Robot;SDK;Pollen</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<!-- RoseAudioLink rides SpawnDev.RTC's cross-platform IRTCPeerConnection (browser + desktop),
		     which bundles the SipSorcery fork and the PCM audio bridge. Concentus + the direct
		     SpawnDev.SIPSorcery reference are no longer needed here. -->
		<PackageReference Include="SpawnDev.RTC" Version="2.3.1" />
	</ItemGroup>

</Project>
